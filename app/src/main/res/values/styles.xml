<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#5E5CE6</item>
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:navigationBarColor">#F2F2F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
        위젯 추가 시 시스템이 띄우는 구성(configure) 화면 전용 테마.

        처음엔 Theme.Material.Dialog + windowIsFloating으로 만들었는데, 일부 제조사
        런처(특히 One UI)는 위젯 configure 액티비티를 자기 쪽에서 태스크로 직접
        띄우면서 windowIsFloating/windowMinWidthMajor 같은 "떠 있는 창" 관련 테마
        속성을 무시하고 그냥 풀스크린으로 그려버린다 — 그래서 테마를 제대로
        바꿔도 삼성 기기에서는 여전히 풀스크린으로 보였던 것.

        그래서 "OS가 작은 창으로 띄워주길" 기대하는 대신, 액티비티 자체는 평범한
        전체 화면 액티비티로 두고 windowIsTranslucent로 배경만 완전히 투명하게
        만든 뒤, 팝업처럼 보이는 어두운 배경 + 가운데 카드는 레이아웃
        (activity_widget_config.xml)에서 우리가 직접 그린다. 이 방식은 런처가
        창을 어떻게 다루든 항상 동일하게 동작한다.

        글자색도 테마 속성(textColorPrimary/Secondary)뿐 아니라 레이아웃의 모든
        View에 인앱 디자인 토큰(widget_text_primary 등, values/values-night)을
        명시적으로 지정해서, 테마 상속 여부와 무관하게 항상 배경과 대비되게 한다.
    -->
    <style name="WidgetConfigDialogTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/widget_accent</item>
        <item name="android:textColorPrimary">@color/widget_text_primary</item>
        <item name="android:textColorSecondary">@color/widget_text_secondary</item>
    </style>
</resources>
