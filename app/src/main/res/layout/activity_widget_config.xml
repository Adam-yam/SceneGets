<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/configRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8A000000"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_config_card"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/configTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="@string/widget_config_subtitle"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/widget_text_secondary" />
<FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_preview_checker"
            android:clipToOutline="true">

            <View
                android:id="@+id/previewCardBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/previewHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_config_preview_header"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/previewBodyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/widget_config_preview_body"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/widget_config_opacity_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textColor="@color/widget_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_config_group"
            android:clipToOutline="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <SeekBar
                android:id="@+id/opacitySeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="@color/widget_accent"
                android:progressBackgroundTint="@color/widget_stroke"
                android:thumbTint="@color/widget_accent" />

            <TextView
                android:id="@+id/opacityValueText"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:textSize="14sp"
                android:textColor="@color/widget_text_primary"
                android:text="100%" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/widget_config_theme_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textColor="@color/widget_text_secondary" />

        <RadioGroup
            android:id="@+id/themeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_config_group"
            android:clipToOutline="true">

            <RadioButton
                android:id="@+id/radioThemeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:buttonTint="@color/widget_accent"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:text="@string/widget_config_theme_system"
                android:checked="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="14dp"
                android:background="@color/widget_divider" />

            <RadioButton
                android:id="@+id/radioThemeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:buttonTint="@color/widget_accent"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:text="@string/widget_config_theme_light" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginStart="14dp"
                android:background="@color/widget_divider" />

            <RadioButton
                android:id="@+id/radioThemeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?android:attr/selectableItemBackground"
                android:buttonTint="@color/widget_accent"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:text="@string/widget_config_theme_dark" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical|end">

            <Button
                android:id="@+id/cancelButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="@color/widget_text_secondary"
                android:text="@string/widget_config_cancel" />

            <Button
                android:id="@+id/confirmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:text="@string/widget_config_confirm"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_config_button_primary" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
